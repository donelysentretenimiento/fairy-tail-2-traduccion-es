<Window x:Class="FT2ES.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="FAIRY TAIL 2 — Traducción al español · By Donelys Entretenimiento"
        Width="1200" Height="780" MinWidth="1000" MinHeight="680"
        Icon="icono.ico" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" Background="#0B0B12" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Sin barra de título de Windows: la interfaz web dibuja la suya (arrastrable) con minimizar y cerrar. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="#0B0B12">
        <wv2:WebView2 x:Name="web" DefaultBackgroundColor="#0B0B12" />
    </Grid>
</Window>
